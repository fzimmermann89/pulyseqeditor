{
  "name": "pulseqjs-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "pypulseq": {
    "version": "1.4.2.post2",
    "repo": "https://github.com/imr-framework/pypulseq"
  },
  "scripts": {
    "ensure:pyodide": "node ./scripts/ensure-pyodide.mjs",
    "ensure:pypulseq": "node ./scripts/ensure-pypulseq.mjs",
    "sync:pypulseq": "node ./scripts/sync-pypulseq.mjs",
    "stage:native-runtime": "node ./scripts/stage-native-runtime.mjs",
    "dev": "npm run ensure:pyodide && npm run ensure:pypulseq && npm run sync:pypulseq && vite",
    "build": "npm run ensure:pyodide && npm run ensure:pypulseq && npm run sync:pypulseq && tsc -b && vite build",
    "build:native-assets": "npm run build && npm run stage:native-runtime",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "codemirror": "^6.0.2",
    "pyodide": "^0.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
